{
  "rules": {
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1' && !newData.exists()))"
      }
    },
    "timeAttackLeaderboards": {
      "$variant": {
        "$questionCount": {
          ".read": "auth != null",
          ".indexOn": "clearTimeMs",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['displayName','clearTimeMs','missCount','achievedAt'])",
            "displayName": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "oshiMemberId": { ".validate": "newData.val() === null || newData.isString()" },
            "clearTimeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 3600000" },
            "missCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "achievedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "timeAttackLeaderboardsV2": {
      "$variant": {
        "$rule": {
          "$questionCount": {
            "$category": {
              ".read": "auth != null",
              ".indexOn": "clearTimeMs",
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || (auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1' && !newData.exists()))",
                ".validate": "newData.hasChildren(['displayName','clearTimeMs','missCount','achievedAt'])",
                "displayName": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "oshiMemberId": { ".validate": "newData.val() === null || newData.isString()" },
                "clearTimeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 3600000" },
                "missCount": { ".validate": "newData.val() === 0" },
                "achievedAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          }
        }
      }
    },
    "timeAttackLeaderboardsV3": {
      "$variant": {
        "$questionCount": {
          "$category": {
            ".read": "auth != null",
            ".indexOn": "clearTimeMs",
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1' && !newData.exists()))",
              ".validate": "newData.hasChildren(['displayName','clearTimeMs','missCount','achievedAt'])",
              "displayName": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "oshiMemberId": { ".validate": "newData.val() === null || newData.isString()" },
              "clearTimeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 3600000" },
              "missCount": { ".validate": "newData.val() === 0" },
              "rule": { ".validate": "newData.val() === null || (newData.isString() && (newData.val() === 'normal' || newData.val() === 'hard' || newData.val() === 'loveChain'))" },
              "source": { ".validate": "newData.val() === null || (newData.isString() && (newData.val() === 'timeAttack' || newData.val() === 'normal'))" },
              "achievedAt": { ".validate": "newData.isNumber()" },
              "actualQuestionCount": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",

        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('version').val() === 1 && newData.child('status').val() === 'waiting' && newData.hasChild('createdAt') && newData.child('maxPlayers').isNumber() && newData.child('maxPlayers').val() >= 1 && newData.child('maxPlayers').val() <= 10 && newData.child('maxSpectators').val() === 10 && newData.child('gameMode').isString() && newData.child('gameMode').val().length > 0 && !newData.hasChild('matches') && !newData.hasChild('results') && !newData.hasChild('seed') && !newData.hasChild('countdownStartedAt') && !newData.hasChild('activeMatchId') && newData.child('players').hasChild(auth.uid)) || (data.exists() && !newData.exists() && data.child('host').val() === auth.uid))",

        "status": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid"
        },

        "gameMode": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid && root.child('rooms/' + $roomId + '/status').val() === 'waiting'",
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "host": {
          ".write": "auth != null && ((data.val() === auth.uid && newData.val() !== auth.uid && root.child('rooms/' + $roomId + '/players/' + newData.val()).exists()) || (newData.val() === auth.uid && newData.val() !== data.val() && root.child('rooms/' + $roomId + '/players/' + auth.uid).exists() && root.child('rooms/' + $roomId + '/players/' + data.val() + '/connected').val() === false))",
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "settings": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
          "battleRuleId": {
            ".validate": "newData.isString() && (newData.val() === 'classic' || newData.val() === 'steal' || newData.val() === 'combo')"
          },
          "battleRuleVersion": {
            ".validate": "newData.isNumber() && newData.val() === 2"
          },
          "answerPoolSizeValue": {
            ".validate": "(newData.val() === 4 || newData.val() === 10 || newData.val() === 30 || newData.val() === 50 || newData.val() === 'all' || newData.val() === '4' || newData.val() === '10') && (newData.parent().child('battleRuleId').val() !== 'steal' || newData.val() === 4 || newData.val() === 10)"
          }
        },
        "settingsRevision": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid"
        },
        "seed": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid"
        },
        "countdownStartedAt": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid"
        },
        "activeMatchId": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
          ".validate": "newData.isString()"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('rooms/' + $roomId + '/host').val() === auth.uid && $uid !== auth.uid && $uid !== root.child('rooms/' + $roomId + '/host').val() && root.child('rooms/' + $roomId + '/status').val() === 'waiting' && !newData.exists()))",
            ".validate": "data.exists() || $uid === auth.uid",
            "ready": {
              ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $roomId + '/host').val() === auth.uid)"
            },
            "readyForRevision": {
              ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $roomId + '/host').val() === auth.uid)"
            },
            "presence": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === 'active' || newData.val() === 'checking' || newData.val() === 'away'"
            }
          }
        },

        "spectators": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "data.exists() || $uid === auth.uid",
            "presence": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === 'active' || newData.val() === 'checking' || newData.val() === 'away'"
            }
          }
        },

        "matches": {
          "$matchId": {
            "participants": {
              "$uid": {
                ".write": "auth != null && !data.exists() && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
                ".validate": "newData.hasChildren(['displayName', 'isHost'])",
                "displayName": { ".validate": "newData.isString() && newData.val().length > 0" },
                "oshiMemberId": { ".validate": "newData.isString() || !newData.exists()" },
                "isHost": { ".validate": "newData.val() === ($uid === root.child('rooms/' + $roomId + '/host').val())" }
              }
            },
            "progress": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && (root.child('rooms/' + $roomId + '/status').val() === 'countdown' || root.child('rooms/' + $roomId + '/status').val() === 'playing') && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/participants/' + auth.uid).exists()",
                ".validate": "newData.hasChildren(['answeredCount', 'finished', 'updatedAt'])",
                "answeredCount": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
                },
                "finished": {
                  ".validate": "newData.isBoolean() && (data.val() !== true || newData.val() === true)"
                },
                "updatedAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "results": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && root.child('rooms/' + $roomId + '/status').val() === 'playing' && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/participants/' + auth.uid).exists()",
                ".validate": "newData.hasChildren(['completed', 'common']) && newData.child('completed').isBoolean()",
                "common": {
                  ".validate": "newData.hasChildren(['elapsedMs', 'correctCount', 'missCount'])",
                  "elapsedMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "correctCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "missCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "replayCount": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000)" }
                }
              }
            },
            "currentQuestionIndex": {
              ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "currentQuestionStartedAt": {
              ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
              ".validate": "newData.isNumber()"
            },
            "questionStatus": {
              ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
              ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'resolved')"
            },
            "resolvedAt": {
              ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
              ".validate": "newData.isNumber()"
            },
            "answers": {
              "$questionIndex": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && (root.child('rooms/' + $roomId + '/matches/' + $matchId + '/currentQuestionIndex').val() + '') === $questionIndex && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/questionStatus').val() === 'active' && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/participants/' + $uid).exists()",
                  ".validate": "newData.hasChildren(['selectedSongId', 'hintLevel', 'answeredAt', 'submittedAt'])",
                  "selectedSongId": { ".validate": "newData.isString() && newData.val().length > 0" },
                  "hintLevel": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4"
                  },
                  "answeredAt": { ".validate": "newData.isNumber()" },
                  "submittedAt": { ".validate": "newData.isNumber()" },
                  "$other": { ".validate": false }
                }
              }
            },
            "forcedSkips": {
              "$questionIndex": {
                "$uid": {
                  ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid && !data.exists() && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && (root.child('rooms/' + $roomId + '/matches/' + $matchId + '/currentQuestionIndex').val() + '') === $questionIndex && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/questionStatus').val() === 'active' && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/participants/' + $uid).exists()",
                  ".validate": "newData.val() === true"
                }
              }
            },
            "questionActivity": {
              "$questionIndex": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid",
                  ".validate": "newData.isNumber()"
                }
              }
            },
            "audioFailures": {
              "$questionIndex": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid",
                  ".validate": "newData.val() === true"
                }
              }
            },
            "questionClaims": {
              "$questionIndex": {
                "winner": {
                  ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && (root.child('rooms/' + $roomId + '/matches/' + $matchId + '/currentQuestionIndex').val() + '') === $questionIndex && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/questionStatus').val() === 'active' && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/answers/' + $questionIndex + '/' + auth.uid).exists()",
                  ".validate": "newData.hasChildren(['uid', 'submittedAt'])",
                  "uid": { ".validate": "newData.isString()" },
                  "submittedAt": { ".validate": "newData.isNumber()" },
                  "$other": { ".validate": false }
                }
              }
            },
            "publicProfiles": {
              ".read": "auth != null",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            },
            "lyricsResults": {
              "$uid": {
                ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid && !data.exists() && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && root.child('rooms/' + $roomId + '/status').val() === 'playing' && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/participants/' + $uid).exists()",
                ".validate": "newData.hasChildren(['ruleVersion', 'completed', 'common']) && newData.child('completed').isBoolean()",
                "common": {
                  ".validate": "newData.hasChildren(['elapsedMs', 'correctCount', 'missCount'])",
                  "elapsedMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "correctCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "missCount": { ".validate": "newData.isNumber() && newData.val() >= 0" }
                }
              }
            },

            "coopRoundNumber": {
              ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "coopVotes": {
              "$questionIndex": {
                "$roundNumber": {
                  "$uid": {
                    ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $roomId + '/activeMatchId').val() === $matchId && root.child('rooms/' + $roomId + '/status').val() === 'playing' && (root.child('rooms/' + $roomId + '/matches/' + $matchId + '/currentQuestionIndex').val() + '') === $questionIndex && (root.child('rooms/' + $roomId + '/matches/' + $matchId + '/coopRoundNumber').val() + '') === $roundNumber && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/questionStatus').val() === 'active' && root.child('rooms/' + $roomId + '/matches/' + $matchId + '/participants/' + $uid).exists()",
                    ".validate": "newData.hasChildren(['selectedSongId', 'submittedAt'])",
                    "selectedSongId": { ".validate": "newData.isString() && newData.val().length > 0" },
                    "submittedAt": { ".validate": "newData.isNumber()" },
                    "$other": { ".validate": false }
                  }
                }
              }
            },
            "coopQuestionOutcomes": {
              "$questionIndex": {
                ".write": "auth != null && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
                ".validate": "newData.hasChildren(['isCorrect', 'usedTieBreakRandom', 'sharedReplayCount']) && newData.child('isCorrect').isBoolean()"
              }
            },
            "coopTeamResult": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $roomId + '/host').val() === auth.uid",
              ".validate": "newData.hasChildren(['totalQuestions', 'correctCount', 'totalSharedReplayCount'])",
              "totalQuestions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "correctCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "totalSharedReplayCount": { ".validate": "newData.isNumber() && newData.val() >= 0" }
            }
          }
        }
      }
    },

    "backups": {
      ".read": "auth != null && auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1'",
      "$backupId": {
        ".read": "auth != null && data.child('currentUid').val() === auth.uid",
        ".write": "auth != null && (auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1' || data.child('currentUid').val() === auth.uid || (!data.exists() && newData.child('currentUid').val() === auth.uid) || (data.child('transfer/secret').exists() && !data.child('transfer/usedAt').exists() && data.child('transfer/expiresAt').val() > now && newData.child('currentUid').val() === auth.uid && newData.child('transfer/secret').val() === data.child('transfer/secret').val() && newData.child('transfer/usedAt').val() === now))",
        ".validate": "newData.hasChildren(['schemaVersion', 'currentUid', 'updatedAt', 'payload'])",
        "schemaVersion": { ".validate": "newData.isNumber()" },
        "currentUid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "displayName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "oshiMemberId": { ".validate": "!newData.exists() || newData.isString()" },
        "achievementCount": { ".validate": "!newData.exists() || newData.isNumber()" },
        "payload": { ".validate": "newData.exists()" },
        "transfer": {
          ".validate": "newData.hasChildren(['secret'])",
          "secret": { ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64" },
          "createdAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "expiresAt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now + 90000000)" },
          "usedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "recoveryRequests": {
      ".read": "auth != null && auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1'",
      "$code": {
        ".read": "auth != null && data.child('newUid').val() === auth.uid",
        ".write": "auth != null && (auth.uid === '1lg2urCowcMqF6r8E7tkc9OOm3r1' || (!data.exists() && newData.child('newUid').val() === auth.uid && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['newUid', 'status', 'requestedAt'])",
        "newUid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'resolved')" },
        "requestedAt": { ".validate": "newData.isNumber()" },
        "resolvedBackupId": { ".validate": "!newData.exists() || newData.isString()" },
        "resolvedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
