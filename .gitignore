# 本物のイントロ音源（著作権保護のため、ローカル環境のみで使用し公開・コミットしない）
assets/audio/local/*
!assets/audio/local/.gitkeep

# 歌詞カードの画像・OCR結果・タイミングデータ（著作権保護のため、ローカル環境のみで使用し公開・コミットしない）
assets/lyrics/local/*
!assets/lyrics/local/.gitkeep

# コールデータ・コールガイドの書き出しJSON（著作権保護のため、ローカル環境のみで使用し
# 公開・コミットしない。dev/generate_full_pack.pyが全曲パックへ取り込む際の置き場所、
# assets/audio/local・assets/lyrics/localと同じ方針、2026-09-06新設）。
assets/calls/local/*
!assets/calls/local/.gitkeep

